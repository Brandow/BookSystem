{% extends 'base.html.twig' %}

{% block title %}
	{{ assunto.Descricao }}
	- Detalhes
{% endblock %}

{% block body %}
	<h1>Assunto / Gênero</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Código</th>
				<td>{{ assunto.CodAs }}</td>
			</tr>
			<tr>
				<th>Descrição</th>
				<td>{{ assunto.Descricao }}</td>
			</tr>
		</tbody>
	</table>

	<div class="mt-4 d-flex gap-2 justify-content-end">
		<a href="{{ path('assunto_index') }}" class="btn btn-outline-secondary">Voltar</a>
		<a href="{{ path('assunto_edit', {'CodAs': assunto.CodAs}) }}" class="btn btn-primary">Editar</a>
		{{ include('assunto/_delete_form.html.twig') }}
	</div>

	<h2 class="mt-4">Livros Relacionados</h2>
	{% if assunto.livros|length > 0 %}
		<table class="table">
			<thead>
				<tr>
					<th>Código</th>
					<th>Título</th>
					<th>Editora</th>
					<th>Edição</th>
					<th>Ano de Publicação</th>
					<th>Valor</th>
                    <th>Ações</th>
				</tr>
			</thead>
			<tbody>
				{% for livro in assunto.livros %}
					<tr>
						<td>{{ livro.Codl }}</td>
						<td>{{ livro.Titulo }}</td>
						<td>{{ livro.Editora }}</td>
						<td>{{ livro.Edicao }}</td>
						<td>{{ livro.AnoPublicacao }}</td>
						<td>R$ {{ livro.Valor|number_format(2, ',', '.') }}</td>
                        <td>
                            <a href="{{ path('livro_show', {'Codl': livro.Codl}) }}" class="btn btn-outline-primary btn-sm">Detalhes</a>
                        </td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<p>Nenhum livro relacionado a este assunto/gênero.</p>
	{% endif %}

{% endblock %}
