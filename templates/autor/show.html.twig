{% extends 'base.html.twig' %}

{% block title %}{{ autor.Nome }} - Detalhes do Autor{% endblock %}

{% block body %}
	<h1>Autor</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Código</th>
				<td>{{ autor.CodAu }}</td>
			</tr>
			<tr>
				<th>Nome</th>
				<td>{{ autor.Nome }}</td>
			</tr>
		</tbody>
	</table>

    <div class="mt-4 d-flex gap-2 justify-content-end">
        <a href="{{ path('autor_index') }}" class="btn btn-outline-secondary">Voltar</a>
        <a href="{{ path('autor_edit', {'CodAu': autor.CodAu}) }}" class="btn btn-primary">Editar</a>
        {{ include('autor/_delete_form.html.twig') }}
    </div>

    <h2 class="mt-4">Livros Publicados</h2>
    {% if autor.livros|length > 0 %}
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Título</th>
                    <th>Editora</th>
                    <th>Edição</th>
                    <th>Ano de Publicação</th>
                    <th>Valor</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for livro in autor.livros %}
                    <tr>
                        <td>{{ livro.Codl }}</td>
                        <td>{{ livro.Titulo }}</td>
                        <td>{{ livro.Editora }}</td>
                        <td>{{ livro.Edicao }}</td>
                        <td>{{ livro.AnoPublicacao }}</td>
                        <td>R$ {{ livro.Valor|number_format(2, ',', '.') }}</td>
                        <td>
                            <a href="{{ path('livro_show', {'Codl': livro.Codl}) }}" class="btn btn-outline-primary btn-sm">Detalhes</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Nenhum livro publicado por este autor.</p>
    {% endif %}
	
{% endblock %}
