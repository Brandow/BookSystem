{% extends 'base.html.twig' %}

{% block title %}Autores Cadastrados
{% endblock %}

{% block body %}
	<h1>Autores Cadastrados</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Código</th>
				<th>Nome</th>
                <th>Livros Publicados</th>
				<th>Ações</th>
			</tr>
		</thead>
		<tbody>
			{% for autor in autors %}
				<tr>
					<td>{{ autor.CodAu }}</td>
					<td>{{ autor.Nome }}</td>
					<td>{{ autor.getQtdLivros() }}</td> 
					<td>
						<div class="d-flex gap-2">
							<a href="{{ path('autor_edit', {'CodAu': autor.CodAu}) }}" class="btn btn-sm btn-secondary">Editar</a>
							<a href="{{ path('autor_show', {'CodAu': autor.CodAu}) }}" class="btn btn-sm btn-info">+ Informações</a>
							{{ include('autor/_delete_form.html.twig') }}
						</div>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="3">Nenhum autor encontrado</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('autor_new') }}" class="btn btn-primary">Cadastrar Novo Autor</a>
{% endblock %}
