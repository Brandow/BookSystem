{% extends 'base.html.twig' %}

{% block title %} {{ livro.Titulo }} {% endblock %}

{% block body %}
	<h1>Livro</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Codl</th>
				<td>{{ livro.Codl }}</td>
			</tr>
			<tr>
				<th>Titulo</th>
				<td>{{ livro.Titulo }}</td>
			</tr>
			<tr>
				<th>Editora</th>
				<td>{{ livro.Editora }}</td>
			</tr>
			<tr>
				<th>
					{{ livro.autores|length > 1 ? 'Autores' : 'Autor' }}
				</th>
				<td>{{ livro.autores|map(a => a.Nome)|join(', ') }}</td>
			</tr>
			<tr>
				<th>
					{{ livro.assuntos|length > 1 ? 'Assuntos/Gêneros' : 'Assunto/Gênero' }}
				</th>
				<td>{{ livro.assuntos|map(s => s.Descricao)|join(', ') }}</td>
			</tr>
			<tr>
				<th>Edicao</th>
				<td>{{ livro.Edicao }}</td>
			</tr>
			<tr>
				<th>AnoPublicacao</th>
				<td>{{ livro.AnoPublicacao }}</td>
			</tr>
			<tr>
				<th>Valor</th>
				<td>R$
					{{ livro.Valor|number_format(2, ',', '.') }}</td>
			</tr>
		</tbody>
	</table>

	<div class="d-flex gap-2 mt-4">
		<a href="{{ path('livro_index') }}" class="btn btn-secondary">Voltar à lista</a>

		<a href="{{ path('livro_edit', {'Codl': livro.Codl}) }}" class="btn btn-primary">Editar</a>

		{{ include('livro/_delete_form.html.twig') }}
	</div>
{% endblock %}
